---
// One English blog post. Drafts are not in the list, so they get no page.
import { render } from 'astro:content';
import BlogPost from '~/components/pages/BlogPost.astro';
import { postsOf, slugOf } from '~/lib/blog';

export async function getStaticPaths() {
  return (await postsOf('en')).map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BlogPost post={post} lang="en"><Content /></BlogPost>
