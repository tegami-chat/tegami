---
import Logo from '~/components/Logo.astro';
import PlatformPills from '~/components/PlatformPills.astro';
import ExtMark from '~/components/ExtMark.astro';
import Container from '~/components/ui/Container.astro';
import { t, link, type Lang } from '~/site';

export interface Props { lang: Lang }
const { lang } = Astro.props;
const x = (k: string) => t(k, lang);
const GH = 'https://github.com/tegami-chat/tegami';
type Item = { text: string; href: string; ext?: boolean };
const columns: { title: string; items: Item[] }[] = [
  { title: x('ft.users'), items: [
    { text: x('nav.how'), href: link('/how', lang) },
    { text: x('nav.status'), href: link('/status', lang) },
    // The comparison page was taken off on 2026-11-19. To bring it back, restore this line and the 'compare' entries in site.ts and PageView.astro.
    { text: x('nav.faq'), href: link('/faq', lang) },
  ] },
  { title: x('ft.project'), items: [
    // The roadmap page was taken off on 2026-11-20. To bring it back, restore this line and the 'roadmap' entries in site.ts and PageView.astro.
    { text: x('ft.docs'), href: link('/developers', lang) },
    { text: x('ft.src'), href: GH, ext: true },
    { text: x('ft.issues'), href: GH + '/issues', ext: true },
  ] },
  { title: x('ft.community'), items: [
    { text: 'X', href: 'https://x.com/tegamichat', ext: true },
    { text: 'Bluesky', href: 'https://bsky.app/profile/tegami.chat', ext: true },
    { text: 'Mastodon', href: 'https://mastodon.social/@tegamichat', ext: true },
    { text: 'Nostr', href: 'https://njump.me/npub1zptpqkxhr98glpt4rqv9945f3hd3q82wghaqth4gwqtmzmtjutsse5a98k', ext: true },
  ] },
];
const hov = 'hover:text-fg';
---
<footer class="border-t border-line text-small text-fg-muted">
  <Container width="wide" class="grid grid-cols-2 gap-8 py-8 md:grid-cols-4">
    <div class="col-span-2 md:col-span-1">
      <a href={link('/', lang)} class="flex items-center gap-2 text-body font-bold text-fg"><Logo id="tg-f" />Tegami</a>
      <p class="mt-3" set:html={x('ft.tag')} />
      <div class="mt-4"><PlatformPills lang={lang} iconOnly /></div>
    </div>
    {columns.map((c) => (
      <div>
        <h3 class="text-small emphasis">{c.title}</h3>
        <ul class="mt-3 space-y-2">
          {c.items.map((i) => <li><a href={i.href} class={hov} target={i.ext ? '_blank' : undefined} rel={i.ext ? 'noopener' : undefined}>{i.text}{i.ext && <ExtMark lang={lang} />}</a></li>)}
        </ul>
      </div>
    ))}
  </Container>
  <Container width="wide" class="flex flex-wrap items-center justify-between gap-4 border-t border-line py-6 text-caption">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2"><a href={link('/privacy', lang)} class={hov}>{x('ft.privacy')}</a><a href={link('/terms', lang)} class={hov}>{x('ft.terms')}</a><a href={link('/about', lang)} class={hov}>{x('ft.about')}</a><a href="mailto:hello@tegami.chat" class={hov}>hello@tegami.chat</a><span>© 2026 Tegami contributors. Licensed under <a href={GH + '/blob/main/LICENSE'} class={'underline ' + hov} target="_blank" rel="noopener">AGPL-3.0<ExtMark lang={lang} /></a>.</span></div>
  </Container>
</footer>
