---
// The animated comparison on the top page ("How Tegami is different").
// The drawing itself is public/diff.js (it builds the tabs and the scenes inside #chips and #scenes,
// in the language of the page). This component supplies the container and the shared SVG parts.
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { t, type Lang } from '~/site';

export interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
---

<WidgetWrapper id="diff" containerClass="max-w-5xl">
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <defs>
      <g id="env">
        <rect x="-23" y="-17" width="46" height="34" rx="6" fill="#1d6b4b"/>
        <path d="M-23 -15 L0 4 L23 -15 V-17 H-23 Z" fill="#bbd3c9"/>
        <circle cx="17" cy="11" r="9" fill="#fff"/>
        <rect x="12.5" y="10" width="9" height="7" rx="1.5" fill="#1d6b4b"/>
        <path d="M14.5 10 V7.5 A2.5 2.5 0 0 1 19.5 7.5 V10" stroke="#1d6b4b" stroke-width="1.8" fill="none"/>
      </g>
      <g id="key">
        <circle cx="-9" cy="0" r="8" fill="none" stroke="#1d6b4b" stroke-width="4.5"/>
        <path d="M-1 0 H16 M10 0 V7 M15 0 V6" stroke="#1d6b4b" stroke-width="4.5" stroke-linecap="round"/>
      </g>
      <g id="face">
        <path d="M-15 -7 V-11 Q-15 -15 -11 -15 H-7 M7 -15 H11 Q15 -15 15 -11 V-7 M15 7 V11 Q15 15 11 15 H7 M-7 15 H-11 Q-15 15 -15 11 V7" stroke="#1d6b4b" stroke-width="3" fill="none" stroke-linecap="round"/>
        <circle cx="-5" cy="-3" r="2" fill="#1d6b4b"/><circle cx="5" cy="-3" r="2" fill="#1d6b4b"/>
        <path d="M-5 6 Q0 10 5 6" stroke="#1d6b4b" stroke-width="2.5" fill="none" stroke-linecap="round"/>
      </g>
      <g id="lock">
        <rect x="-11" y="-3" width="22" height="17" rx="3" fill="currentColor"/>
        <path d="M-6.5 -3 V-8 A6.5 6.5 0 0 1 6.5 -8 V-3" stroke="currentColor" stroke-width="3.5" fill="none"/>
      </g>
      <g id="person">
        <circle cx="0" cy="-12" r="9" fill="currentColor"/>
        <path d="M-17 16 Q-17 -1 0 -1 Q17 -1 17 16 Z" fill="currentColor"/>
      </g>
      <g id="spark">
        <path d="M0 -13 Q2 -2 13 0 Q2 2 0 13 Q-2 2 -13 0 Q-2 -2 0 -13 Z" fill="currentColor"/>
      </g>
    </defs>
  </svg>
  <Headline title={t('diff.h', lang)} subtitle={t('diff.t', lang)} />
  <div id="chips" class="mx-auto flex max-w-3xl flex-wrap justify-center gap-2" role="tablist"></div>
  <div id="scenes" class="mt-8"></div>
</WidgetWrapper>
<script is:inline src="/diff.js" defer></script>
