---
// The mark for a link that opens in a new tab: a small arrow icon and a note for screen readers.
export interface Props { lang?: 'en' | 'ja'; noicon?: boolean }
const { lang = 'en', noicon = false } = Astro.props;
---
{!noicon && <svg viewBox="0 0 24 24" class="ml-1 inline-block h-[0.85em] w-[0.85em] align-[-0.1em]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>}<span class="sr-only">{lang === 'ja' ? '（新しいタブで開きます）' : ' (opens in a new tab)'}</span>
