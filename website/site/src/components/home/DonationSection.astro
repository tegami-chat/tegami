---
import { t, link, type Lang } from '~/site';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Card from '~/components/ui/Card.astro';
import Icon from '~/components/ui/Icon.astro';
import CopyButton from '~/components/ui/CopyButton.astro';
import IconChip from '~/components/ui/IconChip.astro';
import ExtMark from '~/components/ExtMark.astro';
import type { IconName } from '~/components/ui/Icon.astro';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
// What the money pays for: [key, icon]
const uses: [string, IconName][] = [['server', 'server'], ['notify', 'bell'], ['photo', 'image'], ['dev', 'code']];
---
<!-- Keeping Tegami independent -->
<Section tone="muted" class="text-center">
  <SectionHeading title={x('don.h')} lead={x('don.t')} align="center" />
  <ul class="grid grid-cols-2 gap-x-6 gap-y-4 text-left lg:grid-cols-4">
    {uses.map(([k, icon]) => (
      <li class="flex items-start gap-3">
        <Icon name={icon} class="mt-1 h-5 w-5 text-accent" />
        <span class="block"><span class="emphasis block"><Fragment set:html={x('don.' + k + '.h')} /></span><span class="block text-small text-fg-muted"><Fragment set:html={x('don.' + k + '.t')} /></span></span>
      </li>
    ))}
  </ul>
  <div class="mt-8 grid gap-4 text-left sm:grid-cols-3">
    <Card variant="outlined" class="relative flex h-full flex-col items-start gap-3 hover:bg-hover">
      <IconChip name="zap" tone="accent" />
      <a href={link('/donate', lang)} class="stretch emphasis block">Lightning (Zap)</a>
      <span class="mt-auto block break-all text-small text-fg-muted">hello@tegami.chat</span>
    </Card>
    <Card variant="outlined" as="a" href="https://github.com/sponsors/azumayoshihiro" target="_blank" rel="noopener" class="flex h-full flex-col items-start gap-3 hover:bg-hover">
      <IconChip name="handshake" tone="accent" />
      <span class="emphasis block">GitHub Sponsors<ExtMark lang={lang} /></span>
      <span class="mt-auto block break-all text-small text-fg-muted">github.com/sponsors/azumayoshihiro</span>
    </Card>
    <Card variant="outlined" class="relative flex h-full flex-col items-start gap-3 hover:bg-hover">
      <IconChip name="gift" tone="accent" />
      <a href="https://www.amazon.co.jp/dp/B004N3APGO" target="_blank" rel="noopener" class="stretch emphasis block"><Fragment set:html={x('don.amz.h')} /><ExtMark lang={lang} /></a>
      <span class="mt-auto flex w-full flex-wrap items-center gap-x-3 gap-y-2 text-small text-fg-muted"><span class="break-all">hello@tegami.chat</span><CopyButton value="hello@tegami.chat" lang={lang} size="sm" class="above" /></span>
    </Card>
  </div>
  <p class="mt-4 text-caption text-fg-muted"><Fragment set:html={x('don.note')} /></p>
</Section>
