---
import { t, type Lang } from '~/site';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Card from '~/components/ui/Card.astro';
import Heading from '~/components/ui/Heading.astro';
import IconChip from '~/components/ui/IconChip.astro';
import ExtMark from '~/components/ExtMark.astro';
import type { IconName } from '~/components/ui/Icon.astro';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
// What the money pays for: [key, icon]
const uses: [string, IconName][] = [['server', 'server'], ['notify', 'bell'], ['photo', 'image'], ['dev', 'code']];
---
<!-- Keeping Tegami independent -->
<Section tone="muted" class="text-center">
  <SectionHeading title={x('don.h')} lead={x('don.t')} align="center" />
  <ul class="grid grid-cols-1 gap-4 text-left sm:grid-cols-2 lg:grid-cols-4">
    {uses.map(([k, icon]) => (
      <Card as="li" variant="outlined" class="flex flex-col items-start gap-3">
        <IconChip name={icon} tone="accent" />
        <Heading level={3}><Fragment set:html={x('don.' + k + '.h')} /></Heading>
        <p class="text-small text-fg-muted"><Fragment set:html={x('don.' + k + '.t')} /></p>
      </Card>
    ))}
  </ul>
  <div class="mt-8 grid gap-4 text-left sm:grid-cols-3">
    <Card variant="outlined" as="a" href="lightning:hello@tegami.chat" class="flex h-full flex-col items-start gap-3 hover:bg-hover">
      <IconChip name="zap" tone="accent" />
      <span class="emphasis block">Lightning (Zap)</span>
      <span class="mt-auto block break-all text-small text-fg-muted">hello@tegami.chat</span>
    </Card>
    <Card variant="outlined" as="a" href="https://github.com/sponsors/azumayoshihiro" target="_blank" rel="noopener" class="flex h-full flex-col items-start gap-3 hover:bg-hover">
      <IconChip name="handshake" tone="accent" />
      <span class="emphasis block">GitHub Sponsors<ExtMark lang={lang} /></span>
      <span class="mt-auto block break-all text-small text-fg-muted">github.com/sponsors/azumayoshihiro</span>
    </Card>
    <Card variant="outlined" class="flex h-full flex-col items-start gap-3">
      <IconChip name="gift" tone="accent" />
      <span class="emphasis block"><Fragment set:html={x('don.amz.h')} /></span>
      <span class="mt-auto block text-small text-fg-muted"><span><Fragment set:html={x('don.amz.t')} /></span> <span class="select-all break-all">hello@tegami.chat</span></span>
    </Card>
  </div>
  <p class="mt-4 text-caption text-fg-muted"><Fragment set:html={x('don.note')} /></p>
</Section>
