---
import { t, type Lang } from '~/site';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Card from '~/components/ui/Card.astro';
import ExtMark from '~/components/ExtMark.astro';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
const uses = ['server', 'notify', 'photo', 'dev'];
---
<!-- Keeping Tegami independent -->
<Section tone="muted" width="prose" class="text-center">
  <SectionHeading title={x('don.h')} lead={x('don.t')} align="center" />
  <ul class="grid grid-cols-2 gap-3 text-left md:grid-cols-4">
    {uses.map((k) => (
      <Card as="li"><span class="emphasis block"><Fragment set:html={x('don.' + k + '.h')} /></span><span class="text-small text-fg-muted"><Fragment set:html={x('don.' + k + '.t')} /></span></Card>
    ))}
  </ul>
  <div class="mt-8 grid gap-3 text-left sm:grid-cols-3">
    <Card variant="outlined"><span class="emphasis block">Lightning (Zap)</span><span class="mt-2 block select-all break-all text-small text-fg-muted">hello@tegami.chat</span></Card>
    <Card variant="outlined" as="a" href="https://github.com/sponsors/azumayoshihiro" target="_blank" rel="noopener" class="emphasis block hover:bg-hover">GitHub Sponsors<ExtMark lang={lang} /></Card>
    <Card variant="outlined"><span class="emphasis block"><Fragment set:html={x('don.amz.h')} /></span><span class="mt-2 block text-small text-fg-muted"><span><Fragment set:html={x('don.amz.t')} /></span> <span class="select-all break-all">hello@tegami.chat</span></span></Card>
  </div>
  <p class="mt-4 text-caption text-fg-muted"><Fragment set:html={x('don.note')} /></p>
</Section>
