---
import { t, type Lang } from '~/site';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Card from '~/components/ui/Card.astro';
import Icon from '~/components/ui/Icon.astro';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
// The last three are Tegami's own, so they are highlighted.
const everyday = ['one', 'group', 'photo', 'voice', 'video', 'sticker', 'vmsg', 'file', 'search', 'devices', 'move', 'block'];
const own = ['ai', 'accounts', 'export'];
---
<!-- Everyday features -->
<Section id="features" tone="muted">
  <SectionHeading title={x('feat.h')} align="center" />
  <ul class="grid grid-cols-2 gap-3 text-small sm:text-body md:grid-cols-3 lg:grid-cols-4">
    {everyday.map((k) => (
      <Card as="li" tile class="flex items-center gap-2"><span class="text-accent" aria-hidden="true">✓</span><span><Fragment set:html={x('feat.' + k)} /></span></Card>
    ))}
    {own.map((k) => (
      <Card as="li" tile variant="accent" class="flex items-center gap-2"><span aria-hidden="true">✓</span><span><Fragment set:html={x('feat.' + k)} /></span></Card>
    ))}
    <Card as="li" tile variant="outlined" class="flex items-center gap-2 text-fg-muted"><Icon name="more" class="h-4 w-4" /><span><Fragment set:html={x('feat.more')} /></span></Card>
  </ul>
</Section>
