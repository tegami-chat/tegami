---
import { t, link, type Lang } from '~/site';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Heading from '~/components/ui/Heading.astro';
import Badge from '~/components/ui/Badge.astro';
import Card from '~/components/ui/Card.astro';
import Button from '~/components/ui/Button.astro';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
// [key, badge status, badge words (default: the standard words for the status)]
type Entry = [string, 'available' | 'planned', string?];
const cards: Entry[] = [['ui', 'planned'], ['share', 'planned'], ['bots', 'available'], ['api', 'available'], ['relay', 'planned'], ['agpl', 'available', x('open')]];
---
<!-- Make it yours. A dark section in both modes (tone inverse). -->
<Section id="desk" tone="inverse">
  <SectionHeading title={x('mk.h')} lead={x('mk.t')} />
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map(([k, status, label]) => (
      <Card variant="outlined" class="flex min-w-0 flex-col gap-2">
        {k === 'api'
          ? <div class="flex flex-wrap gap-2 self-start"><Badge status="available" lang={lang} label={x('mk.api.mcp') + ' ' + x('now')} /><Badge status="planned" lang={lang} label={x('mk.api.api') + ' ' + x('st.plan')} /></div>
          : <Badge status={status} lang={lang} label={label} class="self-start" />}
        <Heading level={3}><Fragment set:html={x('mk.' + k + '.h')} /></Heading>
        <p class="text-small text-fg-muted"><Fragment set:html={x('mk.' + k + '.t')} /></p>
        {k === 'bots' && <code class="overflow-x-auto whitespace-nowrap rounded-control bg-page px-3 py-2 text-small text-fg-muted">node agent.mjs init --name Claude</code>}
      </Card>
    ))}
  </div>
  <Button href={link('/developers', lang)} variant="secondary" size="sm" class="mt-8"><Fragment set:html={x('mk.dev')} /></Button>
</Section>
