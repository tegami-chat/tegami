---
import { t, type Lang } from '~/site';
import Section from '~/components/ui/Section.astro';
import Heading from '~/components/ui/Heading.astro';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
const pillars = ['p1', 'p2', 'p3'];
---
<Section rhythm="default" trim="start">
  <div class="mt-12 grid gap-8 md:grid-cols-3">
    {pillars.map((p) => (
      <div>
        <Heading level={3}><Fragment set:html={x(p + '.h')} /></Heading>
        <p class="mt-2 text-fg-muted"><Fragment set:html={x(p + '.t')} /></p>
      </div>
    ))}
  </div>
</Section>
