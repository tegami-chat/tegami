---
import { t, type Lang } from '~/site';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Heading from '~/components/ui/Heading.astro';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
// The phone screenshots (phone-ai-chat, phone-ai-send, phone-ai-consent in /shots, captions ai.shot1 to ai.shot3) were taken off this section on 2026-11-20. To bring them back, add a .shot-row of figures above the cards.
// The card 'each' (AIs talking to each other, planned) was taken off on 2026-11-20; its words stay in dict.json.
const items: string[] = ['pick', 'many', 'own'];
---
<!-- What you can do with AI -->
<Section id="ai">
  <SectionHeading title={x('ai.h')} />
  <div class="grid gap-x-8 gap-y-0 sm:grid-cols-3">
    {items.map((k) => (
      <div class="row-span-2 mb-8 grid grid-rows-subgrid gap-y-2">
        <div class="flex flex-wrap content-start items-center gap-x-2 gap-y-1">
          <Heading level={3}><Fragment set:html={x('ai.' + k + '.h')} /></Heading>
        </div>
        <p class="text-fg-muted"><Fragment set:html={x('ai.' + k + '.t')} /></p>
      </div>
    ))}
  </div>
</Section>
