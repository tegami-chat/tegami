---
import { t, type Lang } from '~/site';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Heading from '~/components/ui/Heading.astro';
import Badge from '~/components/ui/Badge.astro';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
// The three phone screens: [picture, caption, alt text, shows the "coming soon" badge]
const shots: [string, string, string, boolean][] = [
  ['phone-ai-chat', 'ai.shot1', 'ai.alt.chat', false],
  ['phone-ai-send', 'ai.shot2', 'hero.alt.send', false],
  ['phone-ai-consent', 'ai.shot3', 'ai.alt.consent', true],
];
// [key, shows the "coming soon" badge]. Talking with the AI and calling it into a group are the screens above.
const items: [string, boolean][] = [['pick', false], ['each', true], ['many', false], ['own', false]];
---
<!-- What you can do with AI -->
<Section id="ai">
  <SectionHeading title={x('ai.h')} />
  <div class="shot-row mb-12">
    {shots.map(([img, cap, alt, coming]) => (
      <figure class="text-center">
        <div class="shot-phone"><img src={`/shots/${img}.webp`} width="780" height="1520" alt={x(alt)} loading="lazy" /></div>
        <p class="mt-4 text-small font-medium text-fg"><Fragment set:html={x(cap)} /></p>
        {coming && <Badge status="coming" lang={lang} class="mt-2" />}
      </figure>
    ))}
  </div>
  <div class="grid gap-x-8 gap-y-0 sm:grid-cols-2 lg:grid-cols-4">
    {items.map(([k, coming]) => (
      <div class="row-span-2 mb-8 grid grid-rows-subgrid gap-y-2">
        <div class="flex flex-wrap content-start items-center gap-x-2 gap-y-1">
          <Heading level={3}><Fragment set:html={x('ai.' + k + '.h')} /></Heading>
          {coming && <Badge status="coming" lang={lang} />}
        </div>
        <p class="text-fg-muted"><Fragment set:html={x('ai.' + k + '.t')} /></p>
      </div>
    ))}
  </div>
</Section>
