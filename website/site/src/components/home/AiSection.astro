---
import { t, type Lang } from '~/site';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Heading from '~/components/ui/Heading.astro';
import Badge from '~/components/ui/Badge.astro';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
// [key, shows the "coming soon" badge]
const items: [string, boolean][] = [['pick', false], ['talk', false], ['join', true], ['each', true], ['many', false], ['own', false]];
---
<!-- What you can do with AI -->
<Section id="ai">
  <SectionHeading title={x('ai.h')} />
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {items.map(([k, coming]) => (
      <div>
        {coming && <Badge status="coming" lang={lang} class="mb-2" />}
        <Heading level={3}><Fragment set:html={x('ai.' + k + '.h')} /></Heading>
        <p class="mt-2 text-fg-muted"><Fragment set:html={x('ai.' + k + '.t')} /></p>
      </div>
    ))}
  </div>
</Section>
