---
// Where Tegami runs: the browser link, and the apps that are not out yet.
import { Icon } from 'astro-icon/components';
import { footerData } from '~/site';

export interface Props {
  lang?: 'en' | 'ja';
  /** Show the "Coming soon" label before the pills that are not out yet (used in the hero and the closing call). */
  labelled?: boolean;
  /** Leave out the browser pill (the page already has a button for it). */
  comingOnly?: boolean;
  /** Centre the pills (hero and closing call); left-aligned otherwise (footer). */
  centered?: boolean;
  class?: string;
}

const { lang = 'en', labelled = false, comingOnly = false, centered = false, class: className = '' } = Astro.props;
const { platforms } = footerData(lang);
const newTab = lang === 'ja' ? '（新しいタブで開きます）' : ' (opens in a new tab)';
const ICONS: Record<string, string> = {
  iphone: 'tabler:device-mobile',
  android: 'tabler:brand-android',
  windows: 'tabler:brand-windows',
  mac: 'tabler:brand-apple',
  linux: 'tabler:brand-ubuntu',
};
---

<div class:list={['flex flex-col gap-2', centered ? 'items-center' : 'items-start', className]}>
{labelled && <p class="text-xs text-muted">{platforms.soon}</p>}
<ul class:list={['flex flex-wrap gap-1.5', centered && 'justify-center']} aria-label={platforms.label}>
  {!comingOnly && <li>
    <a
      href={platforms.browser.href}
      title={platforms.browser.title}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1.5 rounded-full border border-gray-300 px-2.5 py-1 text-xs hover:border-primary hover:text-primary dark:border-slate-600 dark:hover:text-blue-200"
    >
      <Icon name="tabler:world" class="w-4 h-4" />
      {platforms.browser.text}
      <span class="sr-only">{newTab}</span>
    </a>
  </li>}
  {
    platforms.others.map(({ id, text }) => (
      <li>
        <span
          class="inline-flex cursor-default items-center gap-1.5 rounded-full border border-dashed border-gray-300 px-2.5 py-1 text-xs text-muted dark:border-slate-700"
          title={platforms.soon}
        >
          <Icon name={ICONS[id]} class="w-4 h-4" />
          {text}
          <span class="sr-only">{platforms.soon}</span>
        </span>
      </li>
    ))
  }
</ul>
</div>
