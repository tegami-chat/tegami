---
// Where Tegami runs, with the real status of each: the browser version is out (a link), the rest are in development or planned.
// The statuses match the roadmap page and the FAQ ("Which devices can I use?").
import { Icon } from 'astro-icon/components';
import { footerData } from '~/site';

export interface Props {
  lang?: 'en' | 'ja';
  /** Centre the pills (hero); left-aligned otherwise (footer). */
  centered?: boolean;
  class?: string;
}

const { lang = 'en', centered = false, class: className = '' } = Astro.props;
const { platforms } = footerData(lang);
const newTab = lang === 'ja' ? '（新しいタブで開きます）' : ' (opens in a new tab)';
const ICONS: Record<string, string> = {
  iphone: 'tabler:device-mobile',
  android: 'tabler:brand-android',
  windows: 'tabler:brand-windows',
  mac: 'tabler:brand-apple',
  linux: 'tabler:brand-ubuntu',
};
const chip = 'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs';
---

<ul class:list={['flex flex-wrap gap-1.5', centered && 'justify-center', className]} aria-label={platforms.label}>
  <li>
    <a
      href={platforms.browser.href}
      title={platforms.browser.title}
      target="_blank"
      rel="noopener"
      class={`${chip} border-primary/40 bg-primary/10 hover:border-primary hover:text-primary dark:border-primary/60 dark:bg-primary/25 dark:hover:text-blue-200`}
    >
      <Icon name="tabler:world" class="w-4 h-4" />
      {platforms.browser.text}
      <span class="font-semibold">{platforms.browser.status}</span>
      <span class="sr-only">{newTab}</span>
    </a>
  </li>
  {
    platforms.others.map(({ id, text, status }) => (
      <li>
        <span class={`${chip} cursor-default border-dashed border-gray-300 text-muted dark:border-slate-700`}>
          <Icon name={ICONS[id]} class="w-4 h-4" />
          {text}
          <span>{status}</span>
        </span>
      </li>
    ))
  }
</ul>
