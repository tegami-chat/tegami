---
// One post: title, date, the Markdown body in the site's reading style, and a link back to the list.
import Base from '~/layouts/Base.astro';
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Prose from '~/components/ui/Prose.astro';
import { t, type Lang } from '~/site';
import { blogPath, slugOf, type Post } from '~/lib/blog';
export interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const meta = { title: post.data.title + ' | Tegami', desc: post.data.description };
---
<Base name="blog" lang={lang} meta={meta} path={blogPath(lang, slugOf(post))}>
<main>
<Section rhythm="page" width="prose">
<SectionHeading level={1} title={post.data.title} flush />
<p class="mb-8 mt-2 text-caption text-fg-muted"><time datetime={post.data.date}>{post.data.date}</time></p>
<Prose><slot /></Prose>
<p class="mt-8"><a href={blogPath(lang)} class="text-accent underline">{t('blog.back', lang)}</a></p>
</Section>
</main>
</Base>
