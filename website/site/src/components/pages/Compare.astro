---
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Prose from '~/components/ui/Prose.astro';
import Table from '~/components/ui/Table.astro';
import { t, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
const rows = ['price', 'signup', 'read', 'ads', 'ai', 'who'];
const apps = ['LINE', 'WhatsApp', 'Signal', 'Telegram', 'Tegami'];
const cols = ['line', 'wa', 'sig', 'tg', 'teg'];
---
<main>
  <Section id="compare" rhythm="page" width="prose">
    <SectionHeading level={1} title={x('cmp.h')} lead={x('cmp.t')} />
    <Prose>
      <Table sticky>
        <thead><tr><th></th>{apps.map((a) => <th>{a}</th>)}</tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr><td class="emphasis"><Fragment set:html={x('cmp.' + r)} /></td>{cols.map((c) => <td><Fragment set:html={x('cmp.' + r + '.' + c)} /></td>)}</tr>
          ))}
        </tbody>
      </Table>
      <p class="text-small"><Fragment set:html={x('cmp.unconf')} /></p>

      <h2><Fragment set:html={x('cmp.diff.h')} /></h2>
      <p><Fragment set:html={x('cmp.diff.t')} /></p>

      <h2><Fragment set:html={x('cmp.weak.h')} /></h2>
      <p><Fragment set:html={x('cmp.weak.1')} /></p>
      <p><Fragment set:html={x('cmp.weak.2')} /></p>
      <p><Fragment set:html={x('cmp.weak.3')} /></p>

      <h2><Fragment set:html={x('cmp.move.h')} /></h2>
      <p><Fragment set:html={x('cmp.move.1')} /></p>
      <p><Fragment set:html={x('cmp.move.2')} /></p>

      <h2><Fragment set:html={x('cmp.store.h')} /></h2>
      <p><Fragment set:html={x('cmp.store.1')} /></p>

      <p class="mt-12 text-small"><Fragment set:html={x('cmp.note')} /></p>
    </Prose>
  </Section>
</main>
