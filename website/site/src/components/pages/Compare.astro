---
import DocPage from '~/components/ui/DocPage.astro';
import DocSection from '~/components/ui/DocSection.astro';
import Table from '~/components/ui/Table.astro';
import Card from '~/components/ui/Card.astro';
import Mark from '~/components/ui/Mark.astro';
import Icon, { type IconName } from '~/components/ui/Icon.astro';
import IconChip from '~/components/ui/IconChip.astro';
import Prose from '~/components/ui/Prose.astro';
import { t, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
type State = 'yes' | 'part' | 'no' | 'unknown' | null;
// Tegami first, so that it sits next to the row names on a phone. The sign in each cell says whether it is good for the person
// (yes), mixed (part), not good (no) or not confirmed (unknown); the words in the cell say the same thing.
const cols = ['teg', 'line', 'wa', 'sig', 'tg'];
const apps: Record<string, string> = { teg: 'Tegami', line: 'LINE', wa: 'WhatsApp', sig: 'Signal', tg: 'Telegram' };
const rows: { id: string; icon: IconName; marks: Record<string, State> }[] = [
  { id: 'price', icon: 'banknote', marks: { teg: 'yes', line: 'part', wa: 'yes', sig: 'yes', tg: 'part' } },
  { id: 'signup', icon: 'smartphone', marks: { teg: 'yes', line: 'no', wa: 'no', sig: 'no', tg: 'no' } },
  { id: 'read', icon: 'lock', marks: { teg: 'yes', line: 'part', wa: 'unknown', sig: 'yes', tg: 'no' } },
  { id: 'ads', icon: 'megaphone', marks: { teg: 'yes', line: 'no', wa: 'no', sig: 'yes', tg: 'part' } },
  { id: 'ai', icon: 'bot', marks: { teg: 'yes', line: 'no', wa: 'no', sig: 'unknown', tg: 'no' } },
  { id: 'who', icon: 'building', marks: { teg: null, line: null, wa: null, sig: null, tg: null } },
];
const toc = [{ id: 'table', label: x('cmp.tbl') }, ...['diff', 'weak', 'move', 'store'].map((id) => ({ id, label: x('cmp.' + id + '.h') }))];
---
<DocPage lang={lang} title={x('cmp.h')} lead={x('cmp.t')} toc={toc} icon="scale">
  <!-- The header picture: a tiny table with a highlighted column. -->
  <div slot="art" class="grid grid-cols-3 gap-2 rounded-box border border-line-strong bg-surface p-3 shadow-pop" aria-hidden="true">
    {['yes', 'no', 'no', 'yes', 'part', 'no', 'yes', 'no', 'yes'].map((s, i) => (
      <span class:list={['flex h-10 w-10 items-center justify-center rounded-control', 'bg-surface-muted']}><Mark state={s as 'yes'} /></span>
    ))}
  </div>

  <!-- The table is the main thing on this page. -->
  <DocSection id="table">
    <Table sticky matrix>
      <thead><tr><th><span class="sr-only"><Fragment set:html={x('cmp.tbl')} /></span></th>{cols.map((c) => <th data-hl={c === 'teg' ? '' : undefined}>{apps[c]}</th>)}</tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row" class="text-left"><span class="flex items-center gap-2"><Icon name={r.icon} class="h-4 w-4 text-fg-muted" /><span><Fragment set:html={x('cmp.' + r.id)} /></span></span></th>
            {cols.map((c) => (
              <td data-hl={c === 'teg' ? '' : undefined}>
                <div class="cell">{r.marks[c] && <Mark state={r.marks[c] as 'yes'} />}<span><Fragment set:html={x('cmp.' + r.id + '.' + c)} /></span></div>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </Table>
    <!-- Footnotes of the table. -->
    <div class="mt-4 space-y-2 text-small text-fg-muted">
      <p class="flex items-start gap-2"><Mark state="unknown" /><span><Fragment set:html={x('cmp.unconf')} /></span></p>
      <p class="flex items-start gap-2"><Icon name="info" class="h-5 w-5" /><span><Fragment set:html={x('cmp.note')} /></span></p>
    </div>
  </DocSection>

  <!-- What is different: the one big statement. -->
  <DocSection id="diff" title={x('cmp.diff.h')} icon="sparkles" card="soft" class="p-6 sm:p-8">
    <p class="text-lead"><Fragment set:html={x('cmp.diff.t')} /></p>
  </DocSection>

  <!-- Where Tegami is behind: three plain, honest rows. -->
  <DocSection id="weak" title={x('cmp.weak.h')} icon="minus">
    <Card variant="note">
      <ul class="iconlist text-fg-muted">
        {['1', '2', '3'].map((n) => <li><Icon name="minus" class="h-5 w-5 text-fg-muted" stroke={3} /><span><Fragment set:html={x('cmp.weak.' + n)} /></span></li>)}
      </ul>
    </Card>
  </DocSection>

  <!-- Moving over: coming in and going out, side by side. -->
  <DocSection id="move" title={x('cmp.move.h')} icon="arrow-right-left">
    <div class="grid gap-4 sm:grid-cols-2">
      <Card variant="muted"><IconChip name="arrow-down" size="sm" /><p class="mt-3 text-fg-muted"><Fragment set:html={x('cmp.move.1')} /></p></Card>
      <Card variant="muted"><IconChip name="arrow-right" size="sm" /><p class="mt-3 text-fg-muted"><Fragment set:html={x('cmp.move.2')} /></p></Card>
    </div>
  </DocSection>

  <DocSection id="store" title={x('cmp.store.h')} icon="database">
    <Prose><p class="text-lead"><Fragment set:html={x('cmp.store.1')} /></p></Prose>
  </DocSection>
</DocPage>
