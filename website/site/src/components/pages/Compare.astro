---
import HeroText from '~/components/widgets/HeroText.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { t, type Lang } from '~/site';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
const apps = [['teg', 'Tegami'], ['line', 'LINE'], ['wa', 'WhatsApp'], ['sig', 'Signal'], ['tg', 'Telegram']];
const rows = ['price', 'signup', 'read', 'ads', 'ai', 'who'];
---

<HeroText title={x('cmp.h')} subtitle={x('cmp.t')} />
<WidgetWrapper prose containerClass="max-w-5xl pt-4 md:pt-4 lg:pt-4">
  <div class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-heading prose-a:text-primary">
    <div class="overflow-x-auto rounded-lg border border-gray-300 dark:border-slate-600" role="region" tabindex="0" aria-label={x('cmp.h')}>
      <table class="my-0 text-base">
        <thead>
          <tr>
            <th class="sticky left-0 bg-page"></th>
            {apps.map(([, name]) => <th class="px-3 py-3 text-left whitespace-nowrap">{name}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row" class="sticky left-0 min-w-28 max-w-36 border-b border-gray-200 bg-page px-3 py-3 text-left align-top dark:border-slate-700" set:html={x(`cmp.${r}`)} />
                {apps.map(([id]) => <td class="min-w-36 px-3 py-3 align-top" set:html={x(`cmp.${r}.${id}`)} />)}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="text-sm" set:html={x('cmp.unconf')} />
    <h2 set:html={x('cmp.diff.h')} />
    <p set:html={x('cmp.diff.t')} />
    <h2 set:html={x('cmp.weak.h')} />
    <p set:html={x('cmp.weak.1')} />
    <p set:html={x('cmp.weak.2')} />
    <p set:html={x('cmp.weak.3')} />
    <h2 set:html={x('cmp.move.h')} />
    <p set:html={x('cmp.move.1')} />
    <p set:html={x('cmp.move.2')} />
    <h2 set:html={x('cmp.store.h')} />
    <p set:html={x('cmp.store.1')} />
    <p class="text-sm" set:html={x('cmp.note')} />
  </div>
</WidgetWrapper>
