---
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Disclosure from '~/components/ui/Disclosure.astro';
import { t, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
const items = ['free', 'read', 'phone', 'devices', 'friends', 'lost', 'multi', 'collect', 'ai', 'spam', 'shutdown', 'dev'];
---
<main>
  <Section id="faq" rhythm="page" width="prose">
    <SectionHeading level={1} title={x('faq.h')} />
    <div class="divide-y divide-line border-y border-line">
      {items.map((k) => (
        <Disclosure>
          <Fragment slot="q"><Fragment set:html={x('faq.' + k + '.q')} /></Fragment>
          <p><Fragment set:html={x('faq.' + k + '.a')} /></p>
        </Disclosure>
      ))}
    </div>
  </Section>
</main>
