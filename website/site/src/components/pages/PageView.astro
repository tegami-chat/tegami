---
// One user page in one language: the shared frame around the page's own content.
import Base from '~/layouts/Base.astro';
import Index from '~/components/pages/Index.astro';
import How from '~/components/pages/How.astro';
import Faq from '~/components/pages/Faq.astro';
import About from '~/components/pages/About.astro';
import Compare from '~/components/pages/Compare.astro';
import Roadmap from '~/components/pages/Roadmap.astro';
import Status from '~/components/pages/Status.astro';
import Privacy from '~/components/pages/Privacy.astro';
import type { Lang, PageName } from '~/site';

export interface Props { name: PageName; lang: Lang }
const { name, lang } = Astro.props;
// The document pages share the table of contents script; the status page also has its live script.
const DOC = ['how', 'status', 'compare', 'faq', 'roadmap'];
const scripts = name === 'index' ? ['/diff.js'] : [...(DOC.includes(name) ? ['/doc-toc.js'] : []), ...(name === 'status' ? ['/status.js'] : [])];
---
<Base name={name} lang={lang} scripts={scripts}>
  {name === 'index' && <Index lang={lang} />}
  {name === 'how' && <How lang={lang} />}
  {name === 'faq' && <Faq lang={lang} />}
  {name === 'about' && <About lang={lang} />}
  {name === 'compare' && <Compare lang={lang} />}
  {name === 'roadmap' && <Roadmap lang={lang} />}
  {name === 'status' && <Status lang={lang} />}
  {name === 'privacy' && <Privacy lang={lang} />}
</Base>
