---
import DocPage from '~/components/ui/DocPage.astro';
import DocSection from '~/components/ui/DocSection.astro';
import Orbit from '~/components/ui/Orbit.astro';
import Heading from '~/components/ui/Heading.astro';
import Icon, { type IconName } from '~/components/ui/Icon.astro';
import Badge, { type Status } from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import { t, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
// The groups are the four states; the words of each group are the status words that were already in dict.json.
const groups: { id: string; status: Status; word: string; icon: IconName; items: string[] }[] = [
  { id: 'done', status: 'available', word: 'rm.done', icon: 'check', items: ['basics', 'calls', 'e2e', 'move', 'accounts', 'ai', 'safety', 'signup', 'qr'] },
  { id: 'built', status: 'coming', word: 'rm.built', icon: 'clock', items: ['aigroup'] },
  { id: 'now', status: 'dev', word: 'rm.now', icon: 'code', items: ['address', 'mobile'] },
  { id: 'plan', status: 'planned', word: 'rm.plan', icon: 'list', items: ['vanish', 'desktop', 'api', 'screens', 'relay', 'nostr', 'export'] },
];
const toc = groups.map((g) => ({ id: g.id, label: x(g.word) }));
---
<DocPage lang={lang} title={x('rm.h')} lead={x('rm.t')} toc={toc} icon="list">
  <Orbit slot="art" main="list" around={['check', 'clock', 'code']} />

  <p class="flex items-start gap-3 text-fg-muted"><Icon name="info" class="mt-1 h-5 w-5" /><span><Fragment set:html={x('rm.note')} /></span></p>

  {groups.map((g) => (
    <DocSection id={g.id} title={`${x(g.word)} <span class="rm-count">${g.items.length}</span>`} icon={g.icon}>
      <ul class="rm-list">
        {g.items.map((k) => (
          <li>
            <div><Badge status={g.status} lang={lang} icon /></div>
            <Heading level={3}><Fragment set:html={x('rm.' + k + '.h')} /></Heading>
            <p class="text-fg-muted"><Fragment set:html={x('rm.' + k + '.t')} /></p>
          </li>
        ))}
      </ul>
    </DocSection>
  ))}

  <div>
    <Button href="https://github.com/tegami-chat/tegami/issues" variant="secondary" size="sm" external lang={lang}><Fragment set:html={x('rm.issue')} /></Button>
  </div>
</DocPage>
