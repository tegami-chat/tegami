---
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Heading from '~/components/ui/Heading.astro';
import Card from '~/components/ui/Card.astro';
import Badge, { type Status } from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import { t, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
const items: [string, Status][] = [
  ['basics', 'available'], ['calls', 'available'], ['e2e', 'available'], ['move', 'available'], ['accounts', 'available'],
  ['ai', 'available'], ['safety', 'available'], ['signup', 'available'], ['qr', 'available'],
  ['aigroup', 'coming'],
  ['address', 'dev'], ['mobile', 'dev'],
  ['vanish', 'planned'], ['desktop', 'planned'], ['api', 'planned'], ['screens', 'planned'], ['relay', 'planned'], ['nostr', 'planned'], ['export', 'planned'],
];
---
<main>
  <Section rhythm="page" class="grid gap-12 md:grid-cols-12">
    <div class="md:sticky md:top-24 md:col-span-5 md:self-start">
      <SectionHeading level={1} title={x('rm.h')} lead={x('rm.t')} flush />
      <p class="mt-4 text-small text-fg-muted"><Fragment set:html={x('rm.note')} /></p>
      <Button href="https://github.com/tegami-chat/tegami/issues" variant="secondary" size="sm" external lang={lang} class="mt-6"><Fragment set:html={x('rm.issue')} /></Button>
    </div>
    <div class="space-y-4 md:col-span-7">
      {items.map(([k, status]) => (
        <Card as="article" variant="outlined">
          <Badge status={status} lang={lang} icon />
          <Heading level={3} class="mt-3"><Fragment set:html={x('rm.' + k + '.h')} /></Heading>
          <p class="mt-2 text-fg-muted"><Fragment set:html={x('rm.' + k + '.t')} /></p>
        </Card>
      ))}
    </div>
  </Section>
</main>
