---
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Prose from '~/components/ui/Prose.astro';
import Card from '~/components/ui/Card.astro';
import { t, link, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
const toc = ['seal', 'server', 'account', 'lost', 'photos', 'calls', 'strangers', 'ai', 'count', 'notyet', 'check'];
---
<main>
  <Section rhythm="page" width="prose">
    <SectionHeading level={1} title={x('sec.h')} lead={x('sec.t')} />
    <Card as="nav" variant="muted" aria-label="On this page"><ol class="grid gap-x-6 gap-y-2 text-small sm:grid-cols-2">
      {toc.map((id, i) => (
        <li><a href={'#' + id} class="hover:underline"><span class="mr-2 text-fg-muted">{i + 1}</span><span><Fragment set:html={x('sec.' + id + '.h')} /></span></a></li>
      ))}
    </ol></Card>
    <div class="mt-6">
    <Section rhythm="compact" divided id="seal" width="none"><Prose>
      <h2><Fragment set:html={x('sec.seal.h')} /></h2>
      <p><Fragment set:html={x('sec.seal.1')} /></p>
    </Prose></Section>
    <Section rhythm="compact" divided id="server" width="none"><Prose>
      <h2><Fragment set:html={x('sec.server.h')} /></h2>
      <h3><Fragment set:html={x('sec.server.1')} /></h3>
      <ul>
        <li><Fragment set:html={x('sec.server.2.1')} /></li>
        <li><Fragment set:html={x('sec.server.2.2')} /></li>
        <li><Fragment set:html={x('sec.server.2.3')} /></li>
        <li><Fragment set:html={x('sec.server.2.4')} /></li>
      </ul>
      <h3><Fragment set:html={x('sec.server.3')} /></h3>
      <ul>
        <li><Fragment set:html={x('sec.server.4.1')} /></li>
        <li><Fragment set:html={x('sec.server.4.2')} /></li>
      </ul>
      <p><Fragment set:html={x('sec.server.5')} /></p>
    </Prose></Section>
    <Section rhythm="compact" divided id="account" width="none"><Prose>
      <h2><Fragment set:html={x('sec.account.h')} /></h2>
      <p><Fragment set:html={x('sec.account.1')} /></p>
      <p><Fragment set:html={x('sec.account.2')} /></p>
    </Prose></Section>
    <Section rhythm="compact" divided id="lost" width="none"><Prose>
      <h2><Fragment set:html={x('sec.lost.h')} /></h2>
      <p><Fragment set:html={x('sec.lost.1')} /></p>
      <p><Fragment set:html={x('sec.lost.2')} /></p>
    </Prose></Section>
    <Section rhythm="compact" divided id="photos" width="none"><Prose>
      <h2><Fragment set:html={x('sec.photos.h')} /></h2>
      <p><Fragment set:html={x('sec.photos.1')} /></p>
    </Prose></Section>
    <Section rhythm="compact" divided id="calls" width="none"><Prose>
      <h2><Fragment set:html={x('sec.calls.h')} /></h2>
      <p><Fragment set:html={x('sec.calls.1')} /></p>
    </Prose></Section>
    <Section rhythm="compact" divided id="strangers" width="none"><Prose>
      <h2><Fragment set:html={x('sec.strangers.h')} /></h2>
      <p><Fragment set:html={x('sec.strangers.1')} /></p>
    </Prose></Section>
    <Section rhythm="compact" divided id="ai" width="none"><Prose>
      <h2><Fragment set:html={x('sec.ai.h')} /></h2>
      <p><Fragment set:html={x('sec.ai.1')} /></p>
      <p><Fragment set:html={x('sec.ai.2')} /></p>
      <p><Fragment set:html={x('sec.ai.3')} /></p>
    </Prose></Section>
    <Section rhythm="compact" divided id="count" width="none"><Prose>
      <h2><Fragment set:html={x('sec.count.h')} /></h2>
      <p><Fragment set:html={x('sec.count.1')} /></p>
    </Prose></Section>
    <Section rhythm="compact" divided id="notyet" width="none"><Prose>
      <h2><Fragment set:html={x('sec.notyet.h')} /></h2>
      <ul>
        <li><Fragment set:html={x('sec.notyet.1.1')} /></li>
        <li><Fragment set:html={x('sec.notyet.1.2')} /></li>
        <li><Fragment set:html={x('sec.notyet.1.3')} /></li>
        <li><Fragment set:html={x('sec.notyet.1.4')} /></li>
      </ul>
    </Prose></Section>
    <Section rhythm="compact" divided id="check" width="none"><Prose>
      <h2><Fragment set:html={x('sec.check.h')} /></h2>
      <p><Fragment set:html={x('sec.check.1')} /></p>
    </Prose></Section>
    </div>
  </Section>
</main>