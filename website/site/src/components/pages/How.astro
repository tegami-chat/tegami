---
import DocPage from '~/components/ui/DocPage.astro';
import DocSection from '~/components/ui/DocSection.astro';
import Orbit from '~/components/ui/Orbit.astro';
import Prose from '~/components/ui/Prose.astro';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import { t, link, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
const ids = ['seal', 'server', 'account', 'lost', 'photos', 'calls', 'strangers', 'ai', 'count', 'check'];
const toc = ids.map((id) => ({ id, label: x('sec.' + id + '.h') }));
---
<DocPage lang={lang} title={x('sec.h')} lead={x('sec.t')} toc={toc} icon="shield" numbered>
  <Orbit slot="art" main="shield" around={['lock', 'key', 'eye-off']} />

  <!-- Every section is the same: an icon and a heading, then plain paragraphs. No boxes around text (the owner's rule, 2026-11-19). -->
  <DocSection id="seal" title={x('sec.seal.h')} icon="lock">
    <p class="text-lead"><Fragment set:html={x('sec.seal.1')} /></p>
  </DocSection>

  <!-- What the server cannot see and can see: two plain columns. -->
  <DocSection id="server" title={x('sec.server.h')} icon="server">
    <div class="grid gap-8 sm:grid-cols-2">
      <div>
        <h3 class="flex items-center gap-2 text-subsection"><Icon name="eye-off" class="h-5 w-5 text-accent" /><Fragment set:html={x('sec.server.1')} /></h3>
        <ul class="iconlist mt-4">
          {['2.1', '2.2', '2.3', '2.4'].map((n) => <li><Icon name="check" class="h-4 w-4 text-accent" stroke={3} /><span><Fragment set:html={x('sec.server.' + n)} /></span></li>)}
        </ul>
      </div>
      <div>
        <h3 class="flex items-center gap-2 text-subsection text-fg-muted"><Icon name="eye" class="h-5 w-5" /><Fragment set:html={x('sec.server.3')} /></h3>
        <ul class="iconlist mt-4">
          {['4.1', '4.2'].map((n) => <li><Icon name="eye" class="h-4 w-4 text-fg-muted" /><span><Fragment set:html={x('sec.server.' + n)} /></span></li>)}
        </ul>
      </div>
    </div>
    <p class="mt-6 flex items-start gap-3 text-fg-muted"><Icon name="clock" class="mt-1 h-5 w-5 text-fg-muted" /><span><Fragment set:html={x('sec.server.5')} /></span></p>
  </DocSection>

  <DocSection id="account" title={x('sec.account.h')} icon="key">
    <div class="space-y-4 text-fg-muted">
      <p><Fragment set:html={x('sec.account.1')} /></p>
      <p><Fragment set:html={x('sec.account.2')} /></p>
    </div>
  </DocSection>

  <DocSection id="lost" title={x('sec.lost.h')} icon="smartphone">
    <div class="space-y-4 text-fg-muted">
      <p><Fragment set:html={x('sec.lost.1')} /></p>
      <p><Fragment set:html={x('sec.lost.2')} /></p>
    </div>
  </DocSection>

  <DocSection id="photos" title={x('sec.photos.h')} icon="image">
    <p class="text-fg-muted"><Fragment set:html={x('sec.photos.1')} /></p>
  </DocSection>

  <DocSection id="calls" title={x('sec.calls.h')} icon="phone-call">
    <p class="text-fg-muted"><Fragment set:html={x('sec.calls.1')} /></p>
  </DocSection>

  <DocSection id="strangers" title={x('sec.strangers.h')} icon="users">
    <p class="text-fg-muted"><Fragment set:html={x('sec.strangers.1')} /></p>
  </DocSection>

  <DocSection id="ai" title={x('sec.ai.h')} icon="bot">
    <div class="space-y-4 text-fg-muted">
      <p class="text-lead"><Fragment set:html={x('sec.ai.1')} /></p>
      <p><Fragment set:html={x('sec.ai.2')} /></p>
      <p><Fragment set:html={x('sec.ai.3')} /></p>
    </div>
  </DocSection>

  <DocSection id="count" title={x('sec.count.h')} icon="chart">
    <Prose><p><Fragment set:html={x('sec.count.1')} /></p></Prose>
  </DocSection>

  <DocSection id="check" title={x('sec.check.h')} icon="code">
    <Prose><p class="text-lead"><Fragment set:html={x('sec.check.1')} /></p></Prose>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button href="https://github.com/tegami-chat/tegami" size="sm" external lang={lang}><Fragment set:html={x('ft.src')} /></Button>
      <Button href={link('/privacy', lang)} variant="secondary" size="sm"><Fragment set:html={x('ft.privacy')} /></Button>
      <Button href={link('/status', lang)} variant="secondary" size="sm"><Fragment set:html={x('sec.check.status')} /></Button>
    </div>
  </DocSection>
</DocPage>
