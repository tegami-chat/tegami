---
import ExtMark from '~/components/ExtMark.astro';
import { t, link, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
---
<main class="mx-auto max-w-3xl px-4 py-14 md:py-20">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl"><Fragment set:html={x('sec.h')} /></h1>
  <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.t')} /></p>
  <nav class="mt-8 rounded-2xl bg-paper p-5 dark:bg-paper-dark" aria-label="On this page"><ol class="grid gap-x-6 gap-y-1.5 text-sm sm:grid-cols-2">
    <li><a href="#seal" class="hover:underline"><span class="mr-1.5 text-neutral-600 dark:text-neutral-400">1</span><span><Fragment set:html={x('sec.seal.h')} /></span></a></li>
    <li><a href="#server" class="hover:underline"><span class="mr-1.5 text-neutral-600 dark:text-neutral-400">2</span><span><Fragment set:html={x('sec.server.h')} /></span></a></li>
    <li><a href="#account" class="hover:underline"><span class="mr-1.5 text-neutral-600 dark:text-neutral-400">3</span><span><Fragment set:html={x('sec.account.h')} /></span></a></li>
    <li><a href="#lost" class="hover:underline"><span class="mr-1.5 text-neutral-600 dark:text-neutral-400">4</span><span><Fragment set:html={x('sec.lost.h')} /></span></a></li>
    <li><a href="#photos" class="hover:underline"><span class="mr-1.5 text-neutral-600 dark:text-neutral-400">5</span><span><Fragment set:html={x('sec.photos.h')} /></span></a></li>
    <li><a href="#calls" class="hover:underline"><span class="mr-1.5 text-neutral-600 dark:text-neutral-400">6</span><span><Fragment set:html={x('sec.calls.h')} /></span></a></li>
    <li><a href="#strangers" class="hover:underline"><span class="mr-1.5 text-neutral-600 dark:text-neutral-400">7</span><span><Fragment set:html={x('sec.strangers.h')} /></span></a></li>
    <li><a href="#ai" class="hover:underline"><span class="mr-1.5 text-neutral-600 dark:text-neutral-400">8</span><span><Fragment set:html={x('sec.ai.h')} /></span></a></li>
    <li><a href="#count" class="hover:underline"><span class="mr-1.5 text-neutral-600 dark:text-neutral-400">9</span><span><Fragment set:html={x('sec.count.h')} /></span></a></li>
    <li><a href="#notyet" class="hover:underline"><span class="mr-1.5 text-neutral-600 dark:text-neutral-400">10</span><span><Fragment set:html={x('sec.notyet.h')} /></span></a></li>
    <li><a href="#check" class="hover:underline"><span class="mr-1.5 text-neutral-600 dark:text-neutral-400">11</span><span><Fragment set:html={x('sec.check.h')} /></span></a></li>
  </ol></nav>
  <div class="mt-6">
    <section id="seal" class="scroll-mt-16 border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('sec.seal.h')} /></h2>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.seal.1')} /></p>
    </section>
    <section id="server" class="scroll-mt-16 border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('sec.server.h')} /></h2>
      <h3 class="mt-4 font-semibold"><Fragment set:html={x('sec.server.1')} /></h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-neutral-600 dark:text-neutral-400">
        <li><Fragment set:html={x('sec.server.2.1')} /></li>
        <li><Fragment set:html={x('sec.server.2.2')} /></li>
        <li><Fragment set:html={x('sec.server.2.3')} /></li>
        <li><Fragment set:html={x('sec.server.2.4')} /></li>
      </ul>
      <h3 class="mt-4 font-semibold"><Fragment set:html={x('sec.server.3')} /></h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-neutral-600 dark:text-neutral-400">
        <li><Fragment set:html={x('sec.server.4.1')} /></li>
        <li><Fragment set:html={x('sec.server.4.2')} /></li>
      </ul>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.server.5')} /></p>
    </section>
    <section id="account" class="scroll-mt-16 border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('sec.account.h')} /></h2>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.account.1')} /></p>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.account.2')} /></p>
    </section>
    <section id="lost" class="scroll-mt-16 border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('sec.lost.h')} /></h2>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.lost.1')} /></p>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.lost.2')} /></p>
    </section>
    <section id="photos" class="scroll-mt-16 border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('sec.photos.h')} /></h2>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.photos.1')} /></p>
    </section>
    <section id="calls" class="scroll-mt-16 border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('sec.calls.h')} /></h2>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.calls.1')} /></p>
    </section>
    <section id="strangers" class="scroll-mt-16 border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('sec.strangers.h')} /></h2>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.strangers.1')} /></p>
    </section>
    <section id="ai" class="scroll-mt-16 border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('sec.ai.h')} /></h2>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.ai.1')} /></p>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.ai.2')} /></p>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.ai.3')} /></p>
    </section>
    <section id="count" class="scroll-mt-16 border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('sec.count.h')} /></h2>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.count.1')} /></p>
    </section>
    <section id="notyet" class="scroll-mt-16 border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('sec.notyet.h')} /></h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-neutral-600 dark:text-neutral-400">
        <li><Fragment set:html={x('sec.notyet.1.1')} /></li>
        <li><Fragment set:html={x('sec.notyet.1.2')} /></li>
        <li><Fragment set:html={x('sec.notyet.1.3')} /></li>
        <li><Fragment set:html={x('sec.notyet.1.4')} /></li>
      </ul>
    </section>
    <section id="check" class="scroll-mt-16 border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('sec.check.h')} /></h2>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('sec.check.1')} /></p>
    </section>
  </div>
</main>