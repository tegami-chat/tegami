---
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Prose from '~/components/ui/Prose.astro';
import { t, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
const rows = ['1', '2', '4', '5', '6'];
---
<main>
  <Section rhythm="page" width="prose">
    <SectionHeading level={1} title={x('op.h')} />
    <Prose>
      <dl>
        {rows.map((n) => (<Fragment><dt><Fragment set:html={x('op.' + n + '.k')} /></dt><dd><Fragment set:html={x('op.' + n + '.v')} /></dd></Fragment>))}
      </dl>
    </Prose>
  </Section>
</main>
