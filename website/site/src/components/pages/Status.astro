---
import DocPage from '~/components/ui/DocPage.astro';
import DocSection from '~/components/ui/DocSection.astro';
import Card from '~/components/ui/Card.astro';
import Icon from '~/components/ui/Icon.astro';
import IconChip from '~/components/ui/IconChip.astro';
import Prose from '~/components/ui/Prose.astro';
import ExtMark from '~/components/ExtMark.astro';
import { t, link, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
const toc = ['use', 'how', 'links'].map((id) => ({ id, label: x('st.' + id + '.h') }));
const stats = [['envelopes', 'st.k.envelopes'], ['files', 'st.k.files'], ['logins', 'st.k.logins'], ['keys', 'st.k.keys']];
---
<DocPage lang={lang} title={x('st.h')} lead={x('st.t')} toc={toc} icon="activity">
  <div slot="art" class="flex items-end gap-4" aria-hidden="true">
    <div class="art-bars"><span class="h1"></span><span class="h2"></span><span class="h3"></span><span class="h4"></span><span class="h5"></span><span class="h6"></span></div>
  </div>

  <div>
    <div id="sample-bar" hidden class="mb-6 rounded-control border border-line border-l-2 border-l-warn bg-surface-muted px-4 py-2 text-center text-small font-semibold text-fg-muted"><Fragment set:html={x('st.sample')} /></div>

    <!-- The live card. status.js sets data-state (checking, up, down) and fills the text. -->
    <div id="banner" class="status-hero" data-state="checking">
      <div>
        <div class="flex items-center gap-3"><span id="dot" class="status-dot"></span><span id="state" class="text-section"></span></div>
        <dl class="mt-4 flex flex-wrap gap-x-2 text-small text-fg-muted"><dt><Fragment set:html={x('st.now.at')} /></dt><dd class="tabular-nums text-fg" id="checked">—</dd></dl>
      </div>
      <div class="sm:text-right">
        <p class="text-title tabular-nums" id="rtt">—</p>
        <p class="mt-1 text-small text-fg-muted"><Fragment set:html={x('st.now.rtt')} /></p>
      </div>
    </div>
  </div>

  <DocSection id="use" title={x('st.use.h')} icon="chart">
    <p class="text-small tabular-nums text-fg-muted" id="period"></p>
    <div id="empty" hidden class="mt-4 rounded-box border border-dashed border-line-strong p-8 text-center text-fg-muted"></div>
    <div id="chart-box" class="mt-4">
      <!-- The newest finished week, as four numbers. status.js fills them. -->
      <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        {stats.map(([k, key]) => (
          <div class="stat"><span class="stat-label"><Fragment set:html={x(key)} /></span><span class="stat-value" id={'stat-' + k}>—</span><span class="stat-week" data-stat-week></span></div>
        ))}
      </div>
      <div id="charts" class="mt-4 grid gap-4 lg:grid-cols-2"></div>
      <div class="mt-3 flex flex-wrap items-center gap-4 text-caption text-fg-muted">
        <span class="flex items-center gap-2"><span class="h-3 w-3 rounded-control bg-accent"></span><span><Fragment set:html={x('st.lg.n')} /></span></span>
        <span class="flex items-center gap-2"><span class="h-3 w-3 rounded-control bg-accent/35"></span><span><Fragment set:html={x('st.lg.u')} /></span></span>
      </div>
    </div>
    <div id="table-wide" class="mt-4 hidden rounded-box border border-line bg-surface p-5 shadow-card">
      <table class="w-full text-small tabular-nums">
        <thead><tr class="text-left text-fg-muted">
          <th class="py-2 pr-3 font-medium"><Fragment set:html={x('st.c.week')} /></th>
          <th class="px-3 py-2 text-right font-medium"><Fragment set:html={x('st.k.envelopes')} /></th>
          <th class="px-3 py-2 text-right font-medium"><Fragment set:html={x('st.k.files')} /></th>
          <th class="px-3 py-2 text-right font-medium"><Fragment set:html={x('st.k.logins')} /></th>
          <th class="py-2 pl-3 text-right font-medium"><Fragment set:html={x('st.k.keys')} /></th>
        </tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
    <ul id="cards" class="mt-4 rounded-box border border-line bg-surface px-4 shadow-card sm:hidden"></ul>
    <button id="more" type="button" hidden class="mt-3 w-full rounded-pill border border-line-strong px-5 py-2 text-small font-semibold hover:bg-hover"></button>
    <Card variant="muted" class="mt-6">
      <ul class="iconlist text-small text-fg-muted">
        <li><Icon name="info" class="h-4 w-4" /><span><Fragment set:html={x('st.use.env')} /></span></li>
        <li><Icon name="info" class="h-4 w-4" /><span><Fragment set:html={x('st.use.note')} /></span></li>
      </ul>
    </Card>
  </DocSection>

  <!-- How the numbers are made: three steps joined by a line. -->
  <DocSection id="how" title={x('st.how.h')} icon="database">
    <ol class="steps">
      <li><IconChip name="database" /><p class="pt-2 text-fg-muted"><Fragment set:html={x('st.how.t0')} /></p></li>
      <li><IconChip name="eye-off" /><p class="pt-2 text-fg-muted"><Fragment set:html={x('st.how.t1')} /></p></li>
      <li><IconChip name="shield" /><p class="pt-2 text-fg-muted"><Fragment set:html={x('st.how.t2')} /></p></li>
    </ol>
  </DocSection>

  <DocSection id="links" title={x('st.links.h')} icon="link">
    <div class="grid gap-3 sm:grid-cols-3">
      <a href="https://relay.tegami.chat/stats" target="_blank" rel="noopener" class="flex flex-col gap-3 rounded-box border border-line bg-surface p-4 font-semibold shadow-card hover:bg-hover"><IconChip name="database" size="sm" /><span><Fragment set:html={x('st.links.json')} /><ExtMark lang={lang} /></span></a>
      <a href="https://github.com/tegami-chat/tegami/blob/main/relay/src/stats.ts" target="_blank" rel="noopener" class="flex flex-col gap-3 rounded-box border border-line bg-surface p-4 font-semibold shadow-card hover:bg-hover"><IconChip name="code" size="sm" /><span><Fragment set:html={x('st.links.code')} /><ExtMark lang={lang} /></span></a>
      <a href={link('/how', lang)} class="flex flex-col gap-3 rounded-box border border-line bg-surface p-4 font-semibold shadow-card hover:bg-hover"><IconChip name="shield" size="sm" /><span><Fragment set:html={x('st.links.how')} /></span></a>
    </div>
    <!-- The technical details: quiet, small. -->
    <Card variant="muted" class="mt-6 text-caption text-fg-muted">
      <dl class="space-y-1">
        <div class="flex flex-wrap gap-x-2"><dt><Fragment set:html={x('st.tech.ver')} />:</dt><dd class="text-fg" id="commit">—</dd></div>
        <div class="flex flex-wrap gap-x-2"><dt><Fragment set:html={x('st.tech.nips')} />:</dt><dd class="tabular-nums text-fg" id="nips">—</dd></div>
      </dl>
      <p class="mt-3"><Fragment set:html={x('st.tech.nipnote')} /></p>
    </Card>
  </DocSection>
</DocPage>
