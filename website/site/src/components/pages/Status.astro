---
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Prose from '~/components/ui/Prose.astro';
import ExtMark from '~/components/ExtMark.astro';
import { t, link, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
---
<main>
  <Section rhythm="page" width="prose">
    <div id="sample-bar" hidden class="mb-6 rounded-control bg-warn-soft px-4 py-2 text-center text-small font-semibold text-warn"><Fragment set:html={x('st.sample')} /></div>
    <SectionHeading level={1} title={x('st.h')} lead={x('st.t')} />

    <!-- The banner and the dot are given their colours by status.js -->
    <div id="banner" class="flex items-center gap-3 rounded-box border border-line px-5 py-4">
      <span id="dot" class="h-3 w-3 shrink-0 rounded-pill bg-line-strong"></span>
      <span id="state" class="text-subsection"></span>
    </div>
    <dl class="mt-3 grid gap-x-6 gap-y-1 text-small text-fg-muted sm:grid-cols-2">
      <div class="flex flex-wrap gap-x-2"><dt><Fragment set:html={x('st.now.rtt')} /></dt><dd class="tabular-nums text-fg" id="rtt">—</dd></div>
      <div class="flex flex-wrap gap-x-2"><dt><Fragment set:html={x('st.now.at')} /></dt><dd class="tabular-nums text-fg" id="checked">—</dd></div>
    </dl>

    <div class="mt-8">
      <Section rhythm="compact" divided width="none">
        <Prose>
          <h2><Fragment set:html={x('st.use.h')} /></h2>
          <p class="text-small tabular-nums" id="period"></p>
          <p class="text-small"><Fragment set:html={x('st.use.env')} /></p>
          <p class="text-small"><Fragment set:html={x('st.use.note')} /></p>
        </Prose>
        <div id="empty" hidden class="mt-4 rounded-box border border-dashed border-line-strong p-8 text-center text-fg-muted"></div>
        <div id="chart-box" class="mt-4">
          <div id="charts" class="space-y-6"></div>
          <div class="mt-3 flex flex-wrap items-center gap-4 text-caption text-fg-muted">
            <span class="flex items-center gap-2"><span class="h-3 w-3 rounded-control bg-accent"></span><span><Fragment set:html={x('st.lg.n')} /></span></span>
            <span class="flex items-center gap-2"><span class="h-3 w-3 rounded-control bg-accent/35"></span><span><Fragment set:html={x('st.lg.u')} /></span></span>
          </div>
        </div>
        <div id="table-wide" class="mt-4 hidden">
          <table class="w-full text-small tabular-nums">
            <thead><tr class="text-left text-fg-muted">
              <th class="py-2 pr-3 font-medium"><Fragment set:html={x('st.c.week')} /></th>
              <th class="px-3 py-2 text-right font-medium"><Fragment set:html={x('st.k.envelopes')} /></th>
              <th class="px-3 py-2 text-right font-medium"><Fragment set:html={x('st.k.files')} /></th>
              <th class="px-3 py-2 text-right font-medium"><Fragment set:html={x('st.k.logins')} /></th>
              <th class="py-2 pl-3 text-right font-medium"><Fragment set:html={x('st.k.keys')} /></th>
            </tr></thead>
            <tbody id="rows"></tbody>
          </table>
        </div>
        <ul id="cards" class="mt-4 sm:hidden"></ul>
        <button id="more" type="button" hidden class="mt-3 w-full rounded-pill border border-line-strong px-5 py-2 text-small font-semibold hover:bg-hover"></button>
      </Section>

      <Section rhythm="compact" divided width="none">
        <Prose>
          <h2><Fragment set:html={x('st.how.h')} /></h2>
          <p><Fragment set:html={x('st.how.t0')} /></p>
          <p><Fragment set:html={x('st.how.t1')} /></p>
          <p><Fragment set:html={x('st.how.t2')} /></p>
        </Prose>
      </Section>

      <Section rhythm="compact" divided width="none">
        <Prose>
          <h2><Fragment set:html={x('st.links.h')} /></h2>
          <ul class="list-none pl-0">
            <li><a href="https://relay.tegami.chat/stats" target="_blank" rel="noopener" class="font-semibold"><Fragment set:html={x('st.links.json')} /><ExtMark lang={lang} /></a></li>
            <li><a href="https://github.com/tegami-chat/tegami/blob/main/relay/src/stats.ts" target="_blank" rel="noopener" class="font-semibold"><Fragment set:html={x('st.links.code')} /><ExtMark lang={lang} /></a></li>
            <li><a href={link('/how', lang)} class="font-semibold"><Fragment set:html={x('st.links.how')} /></a></li>
          </ul>
          <p class="text-caption"><span><Fragment set:html={x('st.tech.ver')} /></span>: <span id="commit">—</span><br><span><Fragment set:html={x('st.tech.nips')} /></span>: <span id="nips" class="tabular-nums">—</span><br><Fragment set:html={x('st.tech.nipnote')} /></p>
        </Prose>
      </Section>
    </div>
  </Section>
</main>
