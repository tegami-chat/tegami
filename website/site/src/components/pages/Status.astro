---
import ExtMark from '~/components/ExtMark.astro';
import { t, link, type Lang } from '~/site';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const x = (k: string) => t(k, lang);
---
<main class="mx-auto max-w-3xl px-4 py-14 md:py-20">
  <div id="sample-bar" hidden class="mb-6 rounded-lg bg-amber-300 px-4 py-2 text-center text-sm font-semibold text-amber-950"><Fragment set:html={x('st.sample')} /></div>
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl"><Fragment set:html={x('st.h')} /></h1>
  <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('st.t')} /></p>

  <div id="banner" class="mt-10 flex items-center gap-3 rounded-2xl border border-neutral-200 px-5 py-4 dark:border-night-line">
    <span id="dot" class="h-3 w-3 shrink-0 rounded-full bg-neutral-300"></span>
    <span id="state" class="text-lg font-bold"></span>
  </div>
  <dl class="mt-3 grid gap-x-6 gap-y-1 text-sm text-neutral-600 dark:text-neutral-400 sm:grid-cols-2">
    <div class="flex flex-wrap gap-x-2"><dt><Fragment set:html={x('st.now.rtt')} /></dt><dd class="tabular-nums text-neutral-900 dark:text-neutral-100" id="rtt">—</dd></div>
    <div class="flex flex-wrap gap-x-2"><dt><Fragment set:html={x('st.now.at')} /></dt><dd class="tabular-nums text-neutral-900 dark:text-neutral-100" id="checked">—</dd></div>
  </dl>

  <div class="mt-12">
    <section class="border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('st.use.h')} /></h2>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400 tabular-nums" id="period"></p>
      <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('st.use.env')} /></p>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('st.use.note')} /></p>
      <div id="empty" hidden class="mt-4 rounded-xl border border-dashed border-neutral-300 p-8 text-center text-neutral-600 dark:border-night-line dark:text-neutral-400"></div>
      <div id="chart-box" class="mt-4">
        <div id="charts" class="space-y-6"></div>
        <div class="mt-3 flex flex-wrap items-center gap-4 text-xs text-neutral-600 dark:text-neutral-400">
          <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-xs bg-forest-600 dark:bg-forest-300"></span><span><Fragment set:html={x('st.lg.n')} /></span></span>
          <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-xs bg-forest-600/35 dark:bg-forest-300/35"></span><span><Fragment set:html={x('st.lg.u')} /></span></span>
        </div>
      </div>
      <div id="table-wide" class="mt-4 hidden">
        <table class="w-full text-sm tabular-nums">
          <thead><tr class="text-left text-neutral-600 dark:text-neutral-400">
            <th class="py-2 pr-3 font-medium"><Fragment set:html={x('st.c.week')} /></th>
            <th class="px-3 py-2 text-right font-medium"><Fragment set:html={x('st.k.envelopes')} /></th>
            <th class="px-3 py-2 text-right font-medium"><Fragment set:html={x('st.k.files')} /></th>
            <th class="px-3 py-2 text-right font-medium"><Fragment set:html={x('st.k.logins')} /></th>
            <th class="py-2 pl-3 text-right font-medium"><Fragment set:html={x('st.k.keys')} /></th>
          </tr></thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
      <ul id="cards" class="mt-4 sm:hidden"></ul>
      <button id="more" type="button" hidden class="mt-3 w-full rounded-full border border-neutral-300 py-2.5 text-sm font-semibold dark:border-night-line"></button>
    </section>

    <section class="border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('st.how.h')} /></h2>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('st.how.t0')} /></p>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('st.how.t1')} /></p>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400"><Fragment set:html={x('st.how.t2')} /></p>
    </section>

    <section class="border-t border-neutral-200 py-8 dark:border-night-line">
      <h2 class="text-2xl font-bold"><Fragment set:html={x('st.links.h')} /></h2>
      <ul class="mt-3 space-y-2">
        <li><a href="https://relay.tegami.chat/stats" target="_blank" rel="noopener" class="font-semibold text-forest-700 underline dark:text-forest-300"><Fragment set:html={x('st.links.json')} /><ExtMark lang={lang} /></a></li>
        <li><a href="https://github.com/tegami-chat/tegami/blob/main/relay/src/stats.ts" target="_blank" rel="noopener" class="font-semibold text-forest-700 underline dark:text-forest-300"><Fragment set:html={x('st.links.code')} /><ExtMark lang={lang} /></a></li>
        <li><a href={link('/how', lang)} class="font-semibold text-forest-700 underline dark:text-forest-300"><Fragment set:html={x('st.links.how')} /></a></li>
      </ul>
      <p class="mt-6 text-xs text-neutral-500 dark:text-neutral-400"><span><Fragment set:html={x('st.tech.ver')} /></span>: <span id="commit">—</span><br><span><Fragment set:html={x('st.tech.nips')} /></span>: <span id="nips" class="tabular-nums">—</span><br><Fragment set:html={x('st.tech.nipnote')} /></p>
    </section>
  </div>
</main>