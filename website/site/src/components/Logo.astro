---
// The Tegami mark (an envelope on paper). Each copy on a page needs its own clip path id.
// size hero = the large app icon on the top page.
export interface Props { id: string; size?: 'sm' | 'hero'; class?: string }
const { id, size = 'sm', class: cls } = Astro.props;
const SIZE = { sm: 'h-8 w-8 rounded-control', hero: 'mx-auto mb-4 h-20 w-20 rounded-[1.4rem] shadow-pop ring-1 ring-black/5 dark:ring-white/10' };
---
<svg viewBox="0 0 1024 1024" class:list={[SIZE[size], cls]} aria-hidden="true"><rect width="1024" height="1024" fill="#f4f1e8"/><g transform="translate(512 512) scale(2.27) translate(-256 -249.5)"><defs><clipPath id={id}><path d="M164 112 H348 Q406 112 406 170 V304 Q406 362 348 362 H164 Q106 362 106 304 V170 Q106 112 164 112 Z"/></clipPath></defs><path d="M138 356 Q146 376 134 398 Q126 412 142 408 Q192 392 232 358 Z" fill="#1d6b4b"/><path clip-path={`url(#${id})`} d="M86 123 L230 234 Q256 254 282 234 L426 123 L426 382 L86 382 Z" fill="#1d6b4b"/><path clip-path={`url(#${id})`} d="M86 92 L426 92 L426 126 L282 237 Q256 257 230 237 L86 126 Z" fill="#bbd3c9"/></g></svg>
