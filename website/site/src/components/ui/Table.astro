---
// A table that scrolls sideways inside its own box. sticky keeps the first column in view while scrolling.
// matrix = the comparison grid: a rounded box, light lines, and the column marked data-hl highlighted.
export interface Props { sticky?: boolean; matrix?: boolean; class?: string }
const { sticky = false, matrix = false, class: cls } = Astro.props;
---
<div class:list={['table-wrap', matrix && 'matrix', cls]}><table data-sticky={sticky ? '' : undefined}><slot /></table></div>
