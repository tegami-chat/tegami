---
// One question that opens to its answer (a native details element, so it works without scripts and from the keyboard).
// Put it inside a container with the class "acc" (see the FAQ page): the container draws the box and the lines between questions.
import Prose from '~/components/ui/Prose.astro';
import Icon from '~/components/ui/Icon.astro';
---
<details class="group">
  <summary class="flex items-start justify-between gap-4 px-5 py-4 emphasis hover:bg-hover"><span><slot name="q" /></span><Icon name="chevron-down" class="mt-1 h-5 w-5 text-fg-muted transition group-open:rotate-180" /></summary>
  <Prose class="px-5 pb-5"><slot /></Prose>
</details>
