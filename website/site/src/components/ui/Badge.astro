---
// A status label. Only the finished states (available, decided) use the accent; the others are grey and differ by their sign. The words come from dict.json so they match on every page; label overrides them for a few special cases.
import { t, type Lang } from '~/site';
export type Status = 'available' | 'coming' | 'dev' | 'planned' | 'decided' | 'discussing';
export interface Props { status: Status; lang: Lang; label?: string; icon?: boolean; class?: string }
const { status, lang, label, icon = false, class: cls } = Astro.props;
const WORDS: Record<Status, string> = { available: 'now', coming: 'st.built', dev: 'rm.now', planned: 'rm.plan', decided: 'badge.decided', discussing: 'badge.discussing' };
const LOOK: Record<Status, string> = {
  available: 'bg-accent-soft text-accent',
  decided: 'bg-accent-soft text-accent',
  coming: 'bg-quiet-soft text-fg-muted',
  discussing: 'bg-quiet-soft text-fg-muted',
  dev: 'bg-quiet-soft text-fg-muted',
  planned: 'bg-quiet-soft text-fg-muted',
};
const MARK: Record<Status, string> = { available: '✓', decided: '✓', coming: '◆', discussing: '◆', dev: '●', planned: '○' };
---
<span class:list={['inline-flex items-center gap-1.5 rounded-pill px-2.5 py-0.5 text-caption font-medium', LOOK[status], cls]}>{icon && <span aria-hidden="true">{MARK[status]}</span>}<span set:html={label ?? t(WORDS[status], lang)} /></span>
