---
// The title block at the top of a page or a section: an optional eyebrow, the title, an optional lead.
// One rule for the space between it and what follows. title, lead and eyebrow are HTML from dict.json.
import Heading from '~/components/ui/Heading.astro';
export interface Props { title: string; lead?: string; eyebrow?: string; level?: 1 | 2 | 3; style?: 'display' | 'title' | 'section' | 'subsection'; align?: 'start' | 'center'; flush?: boolean; id?: string }
const { title, lead, eyebrow, level = 2, style, align = 'start', flush = false, id } = Astro.props;
const center = align === 'center';
---
<div class:list={[!flush && 'mb-8', center && 'text-center']}>
  {eyebrow && <p class="mb-3 text-small font-medium text-fg-muted" set:html={eyebrow} />}
  <Heading level={level} style={style} id={id}><Fragment set:html={title} /></Heading>
  {lead && <p class:list={['mt-4 max-w-prose text-lead text-fg-muted', center && 'mx-auto']} set:html={lead} />}
  <slot />
</div>
