---
// A box. plain = a coloured surface, outlined = surface with a border and a faint shadow, muted = paper colour,
// accent = the highlighted tile, soft = the pale green box, violet = the pale purple box, note = the pale amber box for something to be careful about.
// tile = the small one-line version (a feature in a grid); every other card has the same padding.
export interface Props { variant?: 'plain' | 'outlined' | 'muted' | 'accent' | 'soft' | 'violet' | 'note'; tile?: boolean; as?: string; class?: string; [key: string]: unknown }
const { variant = 'plain', tile = false, as: Tag = 'div', class: cls, ...rest } = Astro.props;
const VARIANT = {
  plain: 'bg-surface',
  outlined: 'border border-line bg-surface shadow-card',
  muted: 'bg-surface-muted',
  accent: 'bg-accent text-on-accent dark:bg-accent-soft dark:text-accent',
  soft: 'border border-accent/25 bg-accent-soft',
  violet: 'border border-accent-2/25 bg-accent-2-soft',
  note: 'border border-warn/30 bg-warn-soft',
};
---
<Tag class:list={['rounded-box', tile ? 'px-4 py-3 font-medium' : 'p-5', VARIANT[variant], cls]} {...rest}><slot /></Tag>
