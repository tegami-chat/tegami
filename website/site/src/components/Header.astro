---
import Logo from '~/components/Logo.astro';
import Container from '~/components/ui/Container.astro';
import Button from '~/components/ui/Button.astro';
import { t, link, type Lang, type PageName } from '~/site';

export interface Props { lang: Lang; current: PageName; alternates: { en: string; ja: string } }
const { lang, current, alternates } = Astro.props;
const x = (k: string) => t(k, lang);
const nav: [PageName, string, string][] = [['how', '/how', 'nav.how'], ['status', '/status', 'nav.status'], ['faq', '/faq', 'nav.faq']];
const here = ' text-fg';
const langOn = 'block px-4 py-2 text-small font-semibold text-accent';
const langOff = 'block px-4 py-2 text-small text-fg hover:bg-hover';
const light = lang === 'ja' ? 'ライト' : 'Light';
const dark = lang === 'ja' ? 'ダーク' : 'Dark';
---
<header class="sticky top-0 z-50 border-b border-line/70 bg-page/80 backdrop-blur">
  <Container width="wide" class="flex h-14 items-center justify-between gap-4">
    <a href={link('/', lang)} class="flex items-center gap-2 text-subsection"><Logo id="tg-h" /><span class="max-[359px]:sr-only">Tegami</span></a>
    <nav class="hidden items-center gap-6 text-small text-fg-muted lg:flex" aria-label="Main">
      {nav.map(([name, path, key]) => <a href={link(path, lang)} class={'hover:text-fg' + (current === name ? here : '')} aria-current={current === name ? 'page' : undefined}>{x(key)}</a>)}
    </nav>
    <div class="flex items-center gap-2 sm:gap-3">
      <Button href="https://app.tegami.chat/" size="sm" external icon={false} lang={lang} class="max-sm:hidden"><Fragment set:html={x('cta.browser')} /></Button>
      <div class="flex rounded-pill border border-line p-0.5" role="group" aria-label={lang === 'ja' ? 'ライトとダーク' : 'Light or dark'}><button type="button" data-theme-set="light" aria-label={light} class="rounded-pill px-2 py-1 bg-fg text-page dark:bg-transparent dark:text-fg-muted dark:hover:text-fg"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button><button type="button" data-theme-set="dark" aria-label={dark} class="rounded-pill px-2 py-1 text-fg-muted hover:text-fg dark:bg-fg dark:text-page"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button></div>
      <details class="relative" data-lang-menu><summary class="flex list-none items-center gap-0.5 rounded-pill px-1.5 py-1 text-fg-muted hover:text-fg" aria-label={lang === 'ja' ? '言語' : 'Language'}><svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12.87 15.07l-2.54-2.51.03-.03A17.52 17.52 0 0014.07 6H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"/></svg><svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M5.3 7.3a1 1 0 011.4 0L10 10.6l3.3-3.3a1 1 0 111.4 1.4l-4 4a1 1 0 01-1.4 0l-4-4a1 1 0 010-1.4z"/></svg></summary><div class="absolute right-0 z-50 mt-2 w-36 overflow-hidden rounded-box border border-line bg-surface py-1 shadow-pop"><a href={alternates.en} hreflang="en" lang="en" class={lang === 'en' ? langOn : langOff} aria-current={lang === 'en' ? 'true' : undefined}>English</a><a href={alternates.ja} hreflang="ja" lang="ja" class={lang === 'ja' ? langOn : langOff} aria-current={lang === 'ja' ? 'true' : undefined}>日本語</a></div></details>
      <details class="relative lg:hidden" data-menu><summary class="flex h-10 w-10 list-none items-center justify-center rounded-pill text-fg hover:bg-hover"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span class="sr-only">{x('nav.menu')}</span></summary>
        <nav class="absolute right-0 z-50 mt-2 w-64 rounded-box border border-line bg-surface p-2 text-body shadow-pop" aria-label="Main">
          {nav.map(([name, path, key]) => <a href={link(path, lang)} class={'block rounded-control px-3 py-2.5 hover:bg-hover' + (current === name ? here : '')} aria-current={current === name ? 'page' : undefined}>{x(key)}</a>)}
          <Button href="https://app.tegami.chat/" size="sm" block external icon={false} lang={lang} class="mt-1 sm:hidden"><Fragment set:html={x('cta.browser')} /></Button>
        </nav>
      </details>
    </div>
  </Container>
</header>
