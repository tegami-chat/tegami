---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { headerData, footerData, type Lang } from '~/site';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  lang: Lang;
  alternates: { en: string; ja: string };
}

const { metadata, lang, alternates } = Astro.props;
---

<Layout metadata={metadata} lang={lang} alternates={alternates}>
  <slot name="head" slot="head" />
  <Header {...headerData(lang)} lang={lang} alternates={alternates} isSticky showToggleTheme />
  <main class="flex-1">
    <slot />
  </main>
  <Footer {...footerData(lang)} lang={lang} />
</Layout>
