{
  // The Tegami web app (Expo web export).
  // Build:  npm run build:web   (clears the cache and checks the relay)
  // Deploy: npx wrangler deploy   (run in this folder, after the build)
  "name": "tegami-app",
  "compatibility_date": "2026-11-11",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "routes": [{ "pattern": "app.tegami.chat", "custom_domain": true }]
}
