{
  // The Tegami relay. One Durable Object holds every message envelope.
  // Dev: npm run dev (ws://localhost:8787)   Deploy: npm run deploy
  "name": "tegami-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  // Encrypted photos and files (Blossom). The bucket deletes objects after 30 days.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "tegami-files" }],
  "routes": [{ "pattern": "relay.tegami.chat", "custom_domain": true }]
}
